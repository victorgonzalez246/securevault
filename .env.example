# Copiar a .env y completar. NUNCA subir .env al repositorio.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
# mysql://usuario:contrasena@host:puerto/base
DATABASE_URL=
# true en produccion (TiDB Cloud exige TLS)
DB_SSL=false
# Opcional: PEM de la CA si el proveedor usa una CA propia
DB_CA_CERT=
# 32+ caracteres aleatorios
SESSION_SECRET=
# "version:llaveBase64" separadas por coma. Generar con: npm run gen-key
ENCRYPTION_KEYS=
ENCRYPTION_KEY_CURRENT=1
# Opcionales
RESEND_API_KEY=
MAIL_FROM=
ALERT_WEBHOOK_URL=
