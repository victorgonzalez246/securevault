{
  "name": "securevault",
  "version": "1.0.0",
  "private": true,
  "description": "SecureVault - notas privadas cifradas con OWASP Top 10:2025",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "rotate-keys": "node --env-file-if-exists=.env scripts/rotate-keys.js",
    "gen-key": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\"",
    "test": "vitest run",
    "build": "npm ci --prefix client --include=dev && npm run build --prefix client",
    "test:audit": "npm audit --audit-level=high && npm audit --audit-level=high --prefix client",
    "verify:prod": "node scripts/verify-prod.mjs",
    "docs:pdf": "node scripts/build-docs.mjs"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "connect-session-sequelize": "^8.0.6",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "otpauth": "^9.6.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "marked": "^18.3.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
